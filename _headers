# Cloudflare Pages: cabeceras de caché y seguridad
# (las reglas que coinciden se combinan; Pages convierte los "Link: rel=preload/preconnect" en 103 Early Hints)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
  Cross-Origin-Opener-Policy: same-origin
  Link: </styles.css>; rel=preload; as=style
  Link: <https://fonts.googleapis.com>; rel=preconnect
  Link: <https://fonts.gstatic.com>; rel=preconnect; crossorigin

/
  Link: </vendor/gsap.min.js>; rel=preload; as=script

# Recursos propios sin hash en el nombre: caché corta + revalidación en segundo plano
/styles.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/site.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/app.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600

# Imágenes del sitio: los nombres no están versionados, así que no "immutable"
/assets/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/ads/*
  Cache-Control: public, max-age=604800

/og-image.jpg
  Cache-Control: public, max-age=604800

# Librerías versionadas
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
